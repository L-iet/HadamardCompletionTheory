theorem codeTrapDeleteRelation_7_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 7*(codeTrapDeletionDenom 7*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 7 0 k*codeTrapDeletionSelector 7 k j)=
      ∑ k,codeTrapDeletionRelation 7 0 k*codeTrapDeletedMatrix 7 k j := by
  decide +kernel


theorem codeTrapDeleteRelation_11_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 11*(codeTrapDeletionDenom 11*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 11 0 k*codeTrapDeletionSelector 11 k j)=
      ∑ k,codeTrapDeletionRelation 11 0 k*codeTrapDeletedMatrix 11 k j := by
  decide +kernel


namespace CompletionTheory
theorem codeTrapDeleteRelation_4_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 4*(codeTrapDeletionDenom 4*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 4 0 k*codeTrapDeletionSelector 4 k j)=
      ∑ k,codeTrapDeletionRelation 4 0 k*codeTrapDeletedMatrix 4 k j := by
  decide +kernel


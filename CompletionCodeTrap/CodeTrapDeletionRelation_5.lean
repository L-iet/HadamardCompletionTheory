theorem codeTrapDeleteRelation_5_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 5*(codeTrapDeletionDenom 5*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 5 0 k*codeTrapDeletionSelector 5 k j)=
      ∑ k,codeTrapDeletionRelation 5 0 k*codeTrapDeletedMatrix 5 k j := by
  decide +kernel


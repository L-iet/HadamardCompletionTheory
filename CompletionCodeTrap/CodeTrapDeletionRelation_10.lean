namespace CompletionTheory
theorem codeTrapDeleteRelation_10_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 10*(codeTrapDeletionDenom 10*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 10 0 k*codeTrapDeletionSelector 10 k j)=
      ∑ k,codeTrapDeletionRelation 10 0 k*codeTrapDeletedMatrix 10 k j := by
  decide +kernel


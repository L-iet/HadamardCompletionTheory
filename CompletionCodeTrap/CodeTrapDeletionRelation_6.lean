theorem codeTrapDeleteRelation_6_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 6*(codeTrapDeletionDenom 6*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 6 0 k*codeTrapDeletionSelector 6 k j)=
      ∑ k,codeTrapDeletionRelation 6 0 k*codeTrapDeletedMatrix 6 k j := by
  decide +kernel


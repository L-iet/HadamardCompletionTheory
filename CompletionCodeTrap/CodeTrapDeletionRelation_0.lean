theorem codeTrapDeleteRelation_0_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 0*(codeTrapDeletionDenom 0*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 0 0 k*codeTrapDeletionSelector 0 k j)=
      ∑ k,codeTrapDeletionRelation 0 0 k*codeTrapDeletedMatrix 0 k j := by
  decide +kernel


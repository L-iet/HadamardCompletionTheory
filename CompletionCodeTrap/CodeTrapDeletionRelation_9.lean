theorem codeTrapDeleteRelation_9_0 : ∀ j : Fin 20,
    codeTrapDeletionMultiplier 9*(codeTrapDeletionDenom 9*(if (0 : Fin 20)=j then (1 : ℤ) else 0)-
      ∑ k,codeTrapDeletionBasis 9 0 k*codeTrapDeletionSelector 9 k j)=
      ∑ k,codeTrapDeletionRelation 9 0 k*codeTrapDeletedMatrix 9 k j := by
  decide +kernel

